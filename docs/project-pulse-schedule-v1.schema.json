{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-pulse.sentinelanvil.workers.dev/schemas/schedule-v1.json",
  "title": "Project Pulse weekly schedule",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "timezone", "blocks"],
  "properties": {
    "version": { "const": 1 },
    "timezone": {
      "type": "string",
      "description": "An IANA timezone such as Europe/Stockholm."
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "category", "days", "start", "end"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "notes": { "type": "string", "maxLength": 1000 },
          "category": {
            "enum": ["fixed", "protected", "focus", "flexible", "routine"]
          },
          "days": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
            }
          },
          "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
          "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
        }
      }
    }
  }
}
